# Copy to .env and fill in from your Supabase project:
#   Supabase dashboard → Project Settings → Data API / API Keys
#
# Both values are safe to ship in a client bundle — the anon key is designed to be
# public and row-level security is what actually protects the data. They live in .env
# only so that pointing the app at a different project is a config change, not a commit.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
